# ─── Magpipe · environment ──────────────────────────────────────────────
# Web dev: copy to .env.local. Everything is optional — the defaults run fully locally.
#
# The packaged desktop app does not read this file. It writes its own config on first launch
# (File → Open Config File):
#   macOS   ~/Library/Application Support/Magpipe/magpipe.env
#   Windows %APPDATA%\Magpipe\magpipe.env
#   Linux   ~/.config/Magpipe/magpipe.env

# Where the embedded database and uploads live. Default: ./.magpipe
MAGPIPE_DATA_DIR=

# Skip sign-in in the browser (`npm run dev:web`). `npm run dev` (desktop) never needs it.
MAGPIPE_AUTH_DISABLED=true

# Footer label. Falls back to the settings row, then "local".
MAGPIPE_REGION=

# Model provider — used once the run engine lands.
ANTHROPIC_API_KEY=

# ─── Hosted deployments only (access mode `signin`, docs/decisions.md D4) ──
# AUTH_SECRET=            # npx auth secret
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
