{
  "name": "magpipe",
  "productName": "Magpipe",
  "version": "0.1.0",
  "private": true,
  "description": "Magpipe — agent orchestrator",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --turbopack --port 3456",
    "build": "npm run build:web && npm run build:electron",
    "build:web": "next build && node scripts/prepare-standalone.mjs",
    "build:electron": "tsc -p electron/tsconfig.json && node scripts/write-app-manifest.mjs",
    "start": "electron .",
    "start:web": "node .next/standalone/server.js",
    "dist": "npm run build && electron-builder --config electron-builder.yml --publish never",
    "seed": "tsx scripts/seed.ts",
    "seed:reset": "tsx scripts/seed.ts --reset",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node -e \"require('fs').rmSync('.magpipe/e2e',{recursive:true,force:true})\" && playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@electric-sql/pglite": "^0.5.15",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@next/env": "15.5.29",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "author": "Magpipe"
}
